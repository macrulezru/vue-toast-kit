{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/.nuxt-dts",
    "outDir": "./dist/.nuxt-dts",
    "rootDir": "./src"
  },
  "include": [
    "src/nuxt/module.ts",
    "src/nuxt/plugin.ts",
    "src/nuxt/nuxt-env.d.ts",
    "src/env.d.ts"
  ]
}
